# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_bank

# Server
HOST=127.0.0.1
PORT=3000
RUST_LOG=secure_bank=debug,tower_http=info,sqlx=warn

# Auth
# Generate a strong random value for production: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# Optional pepper for Argon2 (store separately from DB in real deployments)
# ARGON2_PEPPER=
